{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equity-workbench:company:0.1",
  "title": "Explicit-forecast company valuation input",
  "description": "Draft input schema. Runtime validation additionally enforces source timing, unit consistency, contiguous future periods, full-year final period, share and market-cap consistency, WACC > g, and terminal growth < ROIC. Metadata assertions do not verify sources or rights.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "sector_model": {
          "const": "non_financial"
        }
      },
      "required": [
        "name",
        "ticker",
        "exchange",
        "currency",
        "sector_model"
      ],
      "additionalProperties": false
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "valuation_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional offset-aware valuation cutoff. When present, all sources require timestamps and market_price.observed_at must match."
    },
    "synthetic": {
      "type": "boolean"
    },
    "units": {
      "const": {
        "money": "millions",
        "shares": "millions",
        "price": "currency_per_share"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "cash": {
          "$ref": "#/$defs/fact"
        },
        "debt": {
          "$ref": "#/$defs/fact"
        },
        "other_claims": {
          "$ref": "#/$defs/fact"
        },
        "other_nonoperating_assets": {
          "$ref": "#/$defs/fact"
        },
        "shares_outstanding": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "valuation_shares": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "market_price": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "market_cap": {
          "$ref": "#/$defs/fact"
        }
      },
      "required": [
        "cash",
        "debt",
        "other_claims",
        "other_nonoperating_assets",
        "shares_outstanding",
        "valuation_shares",
        "market_price"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "assumptions": {
      "type": "object",
      "properties": {
        "wacc": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "terminal_growth": {
          "type": "number",
          "minimum": 0
        },
        "terminal_roic": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "terminal_operating_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "terminal_tax_rate": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "discount_convention": {
          "const": "end_period_actual_365"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "wacc",
        "terminal_growth",
        "terminal_roic",
        "terminal_operating_margin",
        "terminal_tax_rate",
        "discount_convention",
        "rationale"
      ],
      "additionalProperties": false
    },
    "forecasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/forecast"
      }
    }
  },
  "required": [
    "schema_version",
    "company",
    "valuation_date",
    "synthetic",
    "units",
    "sources",
    "facts",
    "assumptions",
    "forecasts"
  ],
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Exchange-local close or equivalent offset-aware instant."
        },
        "observation_basis": {
          "const": "latest_completed_session",
          "description": "For a live information snapshot, use a recent completed session separate from the information cutoff."
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "source_id",
        "period_end",
        "basis"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "HTTP(S) source URL, or synthetic:// only for an explicitly fictional case."
        },
        "published_at": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "permitted",
            "restricted",
            "unknown"
          ]
        },
        "cloud_processing": {
          "type": "string",
          "enum": [
            "permitted",
            "restricted",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "published_at",
        "retrieved_at",
        "redistribution",
        "cloud_processing"
      ],
      "additionalProperties": false
    },
    "forecast": {
      "type": "object",
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "revenue": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "operating_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tax_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "net_reinvestment": {
          "type": "number"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "period_start",
        "period_end",
        "revenue",
        "operating_margin",
        "tax_rate",
        "net_reinvestment",
        "rationale"
      ],
      "additionalProperties": false
    }
  }
}
